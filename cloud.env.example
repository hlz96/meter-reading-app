# ============================================================
# 云数据库连接配置模板
# 用法:cp cloud.env.example cloud.env,填入你的阿里云 RDS 信息
# ⚠️ cloud.env 含密码,已被 .gitignore 忽略,切勿提交到版本库
# 详细开通步骤见 docs/云数据库连接-方案A-阿里云RDS.md
# ============================================================

# RDS 外网连接串。把 rm-xxxx 换成你的 RDS 外网地址,端口通常 3306。
CLOUD_DB_URL="jdbc:mysql://rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/meter_reading?useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"

# RDS 上创建的账号
CLOUD_DB_USERNAME=meter

# 该账号的密码(在 RDS 控制台设置)
CLOUD_DB_PASSWORD=改成你的RDS账号密码
