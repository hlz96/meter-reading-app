# ============================================================
# 环境变量样例 — 复制为 .env 并改成你自己的强密码
#   cp .env.example .env
# ⚠️ .env 含密码,已在 .gitignore 中忽略,切勿提交到 git
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=改成一个强root密码
MYSQL_DATABASE=meter_reading
MYSQL_USER=meter
MYSQL_PASSWORD=改成一个强业务库密码

# ---- Redis ----
REDIS_PASSWORD=改成一个强redis密码

# ---- 后端 ----
# 本地 build 出的镜像名,或镜像仓库地址,如 registry.cn-hangzhou.aliyuncs.com/xxx/meter-backend:1.0.0
BACKEND_IMAGE=meter-backend:latest
# JWT 签名密钥,至少 32 位随机串,可用 `openssl rand -base64 48` 生成
JWT_SECRET=改成至少32位的随机字符串
